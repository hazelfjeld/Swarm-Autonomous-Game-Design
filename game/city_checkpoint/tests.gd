extends SceneTree

const Model = preload("res://city_model.gd")
const Adapter = preload("res://checkpoint_adapter.gd")
var failures: int = 0
var checks: int = 0
func check(condition: bool, name: String) -> void:
	checks += 1
	if not condition:
		failures += 1
		push_error("FAIL: " + name)
	else:
		print("PASS: " + name)
func _initialize() -> void:
	var m = Model.new()
	check(m.gold == 1200 and m.food == 240 and m.level == 1 and m.xp == 0, "opening ledger")
	var occupied: Dictionary = {}
	var good: bool = true
	for b in Model.BUILDINGS:
		for x in range(b.x,b.x+b.size):
			for y in range(b.y,b.y+b.size):
				var cell := Vector2i(x,y)
				if x >= 8 or y >= 8 or occupied.has(cell):
					good = false
				occupied[cell] = true
	check(good and occupied.size() == 17, "starter footprints")
	m.advance(29999)
	check(m.stored_gold() == 0, "fractional income retained")
	m.advance(1)
	check(m.stored_gold() == 1, "30 seconds produces one Gold")
	check(m.command("collect","","collect-1",0).ok and m.gold == 1201, "collect earned Gold")
	check(m.command("collect","","collect-1",0).ok and m.gold == 1201, "duplicate operation no payout")
	check(not m.command("feed","","collect-1",1).ok, "conflicting operation ID")
	check(not m.command("plant","sprout","stale",0).ok and m.crop.is_empty(), "stale revision rejected")
	check(m.command("sample","","sample",1).ok and m.xp == 100 and m.gold == 1211, "sample receipt separate from production")
	check(not m.command("sample","","sample-again",2).ok, "sample not repeated")
	check(m.command("plant","sprout","plant",2).ok and m.gold == 1191, "paid planting")
	check(not m.command("plant","ribbon","busy",3).ok and m.gold == 1191, "occupied farm no debit")
	check(not m.command("harvest","","early",3).ok, "early harvest refused")
	m.advance(59999)
	check(not m.command("harvest","","still-early",3).ok, "deadline boundary")
	m.advance(1)
	check(m.command("harvest","","harvest",3).ok and m.food == 280 and m.xp == 105, "harvest exact output")
	check(not m.command("harvest","","repeat",4).ok and m.food == 280, "repeat harvest refused")
	for n in range(12):
		check(m.command("feed","","feed-%d"%n,m.revision).ok,"feed pip %d"%n)
	check(m.level == 4 and m.pips == 0 and m.food == 180, "level four costs exactly 100 Food")
	var old_ticks: int = m.income_ticks
	m.advance(60000)
	check(m.income_ticks-old_ticks == 840, "level four resident rate")
	m.advance(7*86400000)
	check(m.stored_gold() == 500, "storage cap")
	var old_time: int = m.elapsed_ms
	m.advance(-1000)
	check(m.elapsed_ms == old_time, "negative delta ignored")
	check(m.command("plant","ribbon","ribbon",m.revision).ok, "five-minute crop")
	m.advance(300000)
	check(m.command("harvest","","ribbon-harvest",m.revision).ok and m.food == 360 and m.xp == 120, "ribbon yields 180 Food and 15 XP")
	var fractional = Model.new()
	fractional.advance(500)
	for n in range(4):
		fractional.command("feed", "", "fractional-%d" % n, fractional.revision)
	fractional.advance(500)
	check(fractional.income_ticks == 9 and fractional.income_subticks == 0, "rate change midway through second preserves old and new contribution")
	var a = Adapter.new()
	a.capture(m.snapshot())
	m.command("feed","","extra",m.revision)
	check(a.last_snapshot["individual"]["pips"] == 0, "adapter copies committed state")
	var town = Model.new()
	check(not town.command("build","grotto,0,3","locked",town.revision).ok and town.gold == 1200, "grotto account gate")
	check(not town.command("build","light,0,0","overlap",town.revision).ok and town.gold == 1200, "overlap rejection before debit")
	check(not town.command("build","light,7,7","bounds",town.revision).ok, "locked land rejected")
	check(town.command("build","light,3,0","light",town.revision).ok and town.gold == 1000, "paid Light habitat")
	check(not town.command("build","tide,0,3","busy-builder",town.revision).ok and town.gold == 1000, "single builder")
	check(not town.command("move","building-1,0,3","pending-move",town.revision).ok, "pending construction cannot move")
	town.advance(29999)
	check(town.xp == 0 and town.pending("building-1"), "construction does not complete early")
	town.advance(1)
	check(town.xp == 50 and town.construction.is_empty(), "construction auto-completes and awards XP once")
	town.advance(30000)
	check(town.xp == 50 and town.income_ticks == 480, "empty habitats do not produce")
	check(town.command("move","building-1,0,3","move-light",town.revision).ok and town.gold == 1000 and town.xp == 50, "free move preserves XP and ID")
	check(town.find_building("building-1")["x"] == 0 and town.find_building("building-1")["y"] == 3, "move commits coordinates")
	check(town.command("move","building-1,3,0","move-back",town.revision).ok, "return Light to opening fixture")
	check(town.command("build","tide,0,3","cancel-start",town.revision).ok, "start cancelable build")
	check(town.command("cancel_build","","cancel",town.revision).ok and town.gold == 960 and town.xp == 50, "80 percent refund without XP")
	check(not town.command("cancel_build","","cancel-again",town.revision).ok, "cannot repeat cancellation")
	check(not town.command("build","farm,3,5","farm-locked",town.revision).ok, "second farm requires account level three")
	# Test-only account XP fixture; onboarding milestone remains unimplemented.
	town.xp = 300
	check(town.command("build","grotto,0,3","grotto",town.revision).ok, "place grotto at GDD fixture")
	town.advance(60000)
	check(town.command("build","farm,3,5","farm-two",town.revision).ok and town.farm_ids().size() == 1, "second farm unavailable during construction")
	town.advance(30000)
	check(town.buildings.size() == 6 and town.farm_ids().size() == 2, "all six opening buildings fit")
	var farm_two: String = town.farm_ids()[1]
	check(town.command("plant","farm-1:sprout","plot-a",town.revision).ok, "plant first farm")
	check(town.command("plant",farm_two+":ribbon","plot-b",town.revision).ok, "plant independent second farm")
	check(town.command("move","farm-1,5,5","move-crop",town.revision).ok and town.farm_crop("farm-1")["job_id"] == "plot-a", "moving farm preserves active job")
	town.advance(60000)
	check(town.command("harvest","farm-1","plot-a-harvest",town.revision).ok and not town.farm_crop(farm_two).is_empty(), "harvest frees only selected farm")
	check(not town.command("harvest",farm_two,"early-b",town.revision).ok, "other crop retains deadline")
	town.advance(240000)
	check(town.command("harvest",farm_two,"plot-b-harvest",town.revision).ok and town.food == 460, "independent exact crop rewards")
	check(not town.command("harvest",farm_two,"repeat-b",town.revision).ok, "second harvest cannot repeat")
	var roster = Model.new()
	check(Model.SPECIES.size() == 6 and Model.SPECIES["pearlcloud"]["elements"] == ["Tide", "Light"], "six catalog records and ordered hybrid elements")
	check(not roster.command("buy_founder","mossdrop","locked-founder",roster.revision).ok and roster.gold == 1200, "Bloom founder gate")
	check(not roster.command("buy_founder","pearlcloud","not-for-sale",roster.revision).ok, "hybrid cannot be purchased")
	check(roster.command("sample","","sample-roster",roster.revision).ok, "normal account tutorial sample")
	check(roster.command("build","light,3,0","light-roster",roster.revision).ok, "normal Light housing")
	check(roster.command("buy_founder","sunbeam","buy-sun",roster.revision).ok and roster.gold == 910, "deterministic founder purchase charges 100")
	check(roster.command("buy_founder","sunbeam","buy-sun",0).ok and roster.gold == 910, "founder purchase retry no debit")
	check(not roster.command("buy_founder","blueberry","busy-slot",roster.revision).ok, "occupied hatchery rejects another egg")
	roster.advance(29999)
	check(not roster.command("place_founder","building-1","early-sun",roster.revision).ok, "early founder claim rejected")
	roster.advance(1)
	check(not roster.command("place_founder","tide-1","wrong-home",roster.revision).ok and not roster.founder_egg.is_empty(), "mismatched housing retains egg")
	check(roster.command("place_founder","building-1","place-sun",roster.revision).ok and roster.individuals.size() == 2 and roster.xp == 350 and roster.account_level() == 3, "place Sunbeam once at level one and unlock farm")
	check(roster.command("place_founder","building-1","place-sun",0).ok and roster.individuals.size() == 2 and roster.xp == 350, "placement retry no duplicate or XP")
	check(not roster.command("place_founder","building-1","again-sun",roster.revision).ok, "empty founder slot no duplicate")
	check(roster.individuals["ray-2"]["level"] == 1 and roster.individuals["ray-2"]["acquisition_receipt"] == "buy-sun", "stable founder acquisition identity")
	roster.advance(30000)
	check(roster.stored_gold("tide-1") == 2 and roster.stored_gold("building-1") == 1, "independent inhabited bins")
	check(not roster.command("move_ray","ray-2,tide-1","wrong-move",roster.revision).ok, "resident cannot move to mismatched home")
	check(roster.command("collect","building-1","collect-sun",roster.revision).ok and roster.stored_gold("building-1") == 0 and roster.stored_gold("tide-1") == 2, "collect only selected bin")
	for id in ["ray-1","ray-2"]:
		for i in range(12):
			check(roster.command("feed",id,"roster-feed-%s-%d" % [id,i],roster.revision).ok, "feed independent founder")
	check(roster.food == 40 and roster.ray_stats("ray-1") == {"health":136,"power":41,"speed":25,"stamina":100}, "two founders trained for 200 Food and exact Common stats")
	check(roster.command("build","grotto,0,3","normal-grotto",roster.revision).ok, "normal grotto construction")
	roster.advance(60000)
	check(roster.xp == 700 and roster.trained_founders_milestone and roster.account_level() == 4, "normal trained-founders milestone unlocks Bloom")
	roster.advance(1000)
	check(roster.xp == 700, "trained-founders milestone not repeated")
	# Explicit test-only hybrid fixture; ordinary acquisition belongs to #23.
	var hybrid_id: String = roster._new_individual("pearlcloud","tide-1","fixture-hybrid")
	roster.individuals[hybrid_id]["level"] = 4
	check(roster.ray_stats(hybrid_id) == {"health":209,"power":42,"speed":23,"stamina":100}, "exact Rare support stats")
	check(roster.ray_rate_ticks(hybrid_id) == 35 and roster.habitat_rate_ticks("tide-1") == 49, "rarity and shared resident rates")
	check(not roster.housing_error("blueberry","tide-1").is_empty(), "Small capacity two")
	var old_bin: int = roster.income_ticks
	check(roster.command("move_ray",hybrid_id+",building-1","hybrid-move",roster.revision).ok, "dual-element ray can move to Light")
	roster.advance(1000)
	check(roster.income_ticks-old_bin == 14 and roster.habitat_rate_ticks("building-1") == 49, "old bin retained and future rates assigned correctly")
	var old_name: String = roster.individuals[hybrid_id]["nickname"]
	check(roster.command("rename",hybrid_id+":Pearlie","rename-hybrid",roster.revision).ok and roster.individuals[hybrid_id]["nickname"] != old_name and roster.individuals[hybrid_id]["id"] == hybrid_id, "rename preserves individual ID")
	check(roster.command("buy_founder","sunbeam","second-sun",roster.revision).ok and roster.founder_remaining() == 120, "later Sunbeam uses ordinary two-minute hatch")
	roster.advance(120000)
	check(not roster.command("place_founder","building-1","full-home",roster.revision).ok and not roster.founder_egg.is_empty(), "full compatible habitat preserves ready egg")
	check(roster.snapshot()["individuals"].size() == 3 and roster.snapshot()["habitat_bins"].size() == 2, "multi-resident state included in snapshot")
	# Test-only account/roster fixtures for the GDD section 15 upgrade-crossing case.
	var large = Model.new()
	check(not large.command("upgrade_habitat","tide-1","locked-upgrade",large.revision).ok and large.gold == 1200, "Large account gate")
	large.xp = 1000
	var second: String = large._new_individual("blueberry","tide-1","fixture-second")
	large.individuals["ray-1"]["level"] = 4
	large.individuals[second]["level"] = 4
	check(large.command("upgrade_habitat","tide-1","upgrade",large.revision).ok and large.gold == 600, "Large upgrade exact debit")
	check(large.command("upgrade_habitat","tide-1","upgrade",0).ok and large.gold == 600, "upgrade retry no second debit")
	check(large.habitat_ids().has("tide-1") and large.habitat_rate_ticks("tide-1") == 0 and large.habitat_capacity("tide-1") == 2, "paused income, occupied habitat remains visible")
	check(not large.command("build","light,3,0","upgrade-busy",large.revision).ok, "upgrade uses single builder")
	large.advance(3600000)
	check(large.stored_gold() == 385 and large.habitat_capacity("tide-1") == 4 and large.habitat_gold_cap("tide-1") == 5000, "GDD sixty-minute resume produces 385 Gold after five-minute pause")
	check(large.xp == 1025 and large.construction.is_empty() and large.resident_ids("tide-1").size() == 2, "upgrade awards 25 XP once and preserves residents")
	large.advance(1)
	check(large.xp == 1025 and not large.command("upgrade_habitat","tide-1","already-large",large.revision).ok, "completion not repeated and max slice tier")
	check(large.housing_error("blueberry","tide-1").is_empty(), "Large accepts third compatible resident")
	large._new_individual("blueberry","tide-1","fixture-third")
	large._new_individual("blueberry","tide-1","fixture-fourth")
	check(not large.housing_error("blueberry","tide-1").is_empty(), "Large caps at four residents")
	large.advance(7*86400000)
	check(large.stored_gold() == 5000, "Large Gold cap")
	var canceled = Model.new()
	canceled.xp = 1000
	canceled.advance(30000)
	check(canceled.command("upgrade_habitat","tide-1","cancel-upgrade-start",canceled.revision).ok, "start second upgrade fixture")
	canceled.advance(299999)
	check(canceled.stored_gold() == 1 and canceled.xp == 1000 and canceled.upgrading("tide-1"), "predeadline bin retained with no XP")
	check(canceled.command("collect","tide-1","collect-during-upgrade",canceled.revision).ok and canceled.gold == 601, "collect remains available during upgrade")
	check(canceled.command("move","tide-1,0,4","move-upgrading",canceled.revision).ok and canceled.upgrading("tide-1"), "move preserves upgrade job")
	check(canceled.command("cancel_build","","cancel-upgrade",canceled.revision).ok and canceled.gold == 1081 and canceled.xp == 1000, "upgrade cancel refunds 480 and no XP")
	check(canceled.habitat_capacity("tide-1") == 2 and canceled.resident_ids("tide-1") == ["ray-1"] and canceled.find_building("tide-1")["y"] == 4, "cancellation retains building, resident and relocation")
	canceled.advance(30000)
	check(canceled.stored_gold() == 1 and canceled.xp == 1000, "canceled upgrade resumes Small production")
	var split = Model.new()
	split.xp = 1000
	split.advance(15000)
	split.command("upgrade_habitat","tide-1","split-upgrade",split.revision)
	split.advance(300000)
	check(split.income_ticks == 120 and split.xp == 1025 and split.habitat_capacity("tide-1") == 4, "exact deadline retains fractional bin")
	split.advance(15000)
	check(split.stored_gold() == 1, "postdeadline production adds to preupgrade fraction")
	# Land is permanent, limited to one adjacent 4x4 purchase in this slice.
	var land = Model.new()
	check(not land.can_place(8,0,2) and not land.can_buy_sector(2,2) and not land.can_buy_sector(4,0), "locked cells, diagonal and outside island rejected")
	check(not land.command("buy_sector","2,2","diagonal",land.revision).ok and land.gold == 1200, "diagonal purchase no debit")
	check(land.command("buy_sector","2,0","sector",land.revision).ok and land.gold == 950 and land.owned_sectors.size() == 5 and land.xp == 0, "first adjacent land exact permanent cost")
	check(land.command("buy_sector","2,0","sector",0).ok and land.gold == 950, "duplicate sector operation no debit")
	check(not land.command("buy_sector","0,2","second-sector",land.revision).ok and land.gold == 950, "second purchase outside first slice")
	check(land.can_place(10,0,2) and not land.can_place(8,0,2) and not land.can_place(10,4,2), "purchased geometry, obstacle and locked neighboring land")
	check(not land.command("clear_obstacle","starter-obstacle","stale-clear",0).ok, "stale clearance revision rejected")
	check(land.command("clear_obstacle","starter-obstacle","clear",land.revision).ok and land.gold == 900 and land.clearance_remaining() == 60, "clearance debits 50 Gold and starts 60 seconds")
	check(land.command("clear_obstacle","starter-obstacle","clear",0).ok and land.gold == 900, "duplicate clearance no debit")
	check(not land.command("build","light,3,0","busy-clear",land.revision).ok, "clearance occupies single builder")
	land.advance(59999)
	check(not land.can_place(8,0,2) and land.xp == 0, "obstacle blocks placement until exact deadline")
	land.advance(1)
	check(land.can_place(8,0,2) and land.xp == 10 and land.starter_obstacle["cleared"], "cleared obstacle unlocks footprint and awards 10 XP")
	land.advance(120000)
	check(not land.command("clear_obstacle","starter-obstacle","repeat-clear",land.revision).ok and land.xp == 10 and land.gold == 900, "clearance never respawns or awards twice")
	check(land.command("move","farm-1,8,0","move-expanded",land.revision).ok and land.find_building("farm-1")["x"] == 8 and land.gold == 900, "free stable building relocation onto purchased land")
	check(land.snapshot()["owned_sectors"].size() == 5 and land.snapshot()["starter_obstacle"]["cleared"], "snapshot includes permanent land and obstacle state")
	var land_cancel = Model.new()
	land_cancel.command("buy_sector","0,2","south",land_cancel.revision)
	land_cancel.command("clear_obstacle","starter-obstacle","start-clear",land_cancel.revision)
	land_cancel.advance(1000)
	check(land_cancel.command("cancel_build","","cancel-clear",land_cancel.revision).ok and land_cancel.gold == 940 and land_cancel.xp == 0 and not land_cancel.starter_obstacle["cleared"], "cancel clearance refunds 40 Gold without clearing")
	check(land_cancel.command("clear_obstacle","starter-obstacle","retry-clear",land_cancel.revision).ok, "canceled obstacle may be cleared again")
	land_cancel.advance(60000)
	check(land_cancel.xp == 10 and land_cancel.gold == 890 and land_cancel.owned_sectors.has("0,2") and land_cancel.can_place(0,8,2), "south sector and retry settle once")
	var broke = Model.new()
	broke.gold = 249
	check(not broke.command("buy_sector","2,0","poor",broke.revision).ok and broke.owned_sectors.size() == 4 and broke.gold == 249, "insufficient purchase no state change")
	broke.gold = 250
	broke.command("buy_sector","2,0","exact",broke.revision)
	check(not broke.command("clear_obstacle","starter-obstacle","poor-clear",broke.revision).ok and broke.gold == 0 and broke.construction.is_empty(), "insufficient clearance no state change")
	# Explicit test-only individuals verify safety, not a player acquisition path.
	var safe = Model.new()
	check(not safe.command("sell_ray","ray-1","last-ray",safe.revision).ok and safe.gold == 1200, "last housed producer cannot be sold")
	check(not safe.command("store_building","tide-1","occupied-home",safe.revision).ok, "occupied habitat cannot be stored")
	var dup_id: String = safe._new_individual("blueberry","tide-1","fixture-duplicate")
	safe.individuals[dup_id]["level"] = 4
	check(safe.command("set_favorite",dup_id+",1","mark",safe.revision).ok, "mark favorite")
	check(not safe.command("sell_ray",dup_id,"favorite-sale",safe.revision).ok and safe.individuals.has(dup_id), "favorite protected")
	check(safe.command("set_favorite",dup_id+",0","unmark",safe.revision).ok, "unmark favorite explicitly")
	check(not safe.command("sell_ray",dup_id,"stale-sale",0).ok and safe.gold == 1200, "stale sale no payout")
	safe.advance(60000)
	var sale_ticks: int = safe.income_ticks
	check(safe.sale_value(dup_id) == 25 and safe.command("sell_ray",dup_id,"sell-dup",safe.revision).ok and safe.gold == 1225, "trained Common sale exact 25 Gold")
	check(safe.command("sell_ray",dup_id,"sell-dup",0).ok and safe.gold == 1225, "sale retry cannot pay twice")
	check(not safe.command("sell_ray",dup_id,"resell",safe.revision).ok and safe.discoveries.has("blueberry"), "sold ID absent; collection stays discovered")
	safe.advance(60000)
	check(safe.income_ticks-sale_ticks == 480, "remaining ray produces; old bin retained")
	var rare_id: String = safe._new_individual("pearlcloud","tide-1","fixture-rare")
	check(safe.sale_value(rare_id) == 150 and safe.command("sell_ray",rare_id,"sell-rare",safe.revision).ok and safe.discoveries.has("pearlcloud"), "Rare sale 150 and lasting discovery")
	var uncommon_id: String = safe._new_individual("kelpskip","tide-1","fixture-uncommon")
	check(safe.sale_value(uncommon_id) == 50 and safe.command("sell_ray","ray-1","sell-starter",safe.revision).ok and safe.individuals.has(uncommon_id), "starter can be sold when another producer remains")
	check(safe.snapshot()["individual"].is_empty() and safe.snapshot()["individuals"].has(uncommon_id), "snapshot safe after original starter sold")
	check(not safe.command("name","Missing","legacy-name",safe.revision).ok, "legacy name cannot address removed starter")
	check(not safe.command("sell_ray",uncommon_id,"last-again",safe.revision).ok, "last producer protection survives starter sale")
	var storage = Model.new()
	check(storage.command("plant","sprout","store-crop",storage.revision).ok, "plant crop for storage test")
	check(not storage.command("store_building","farm-1","growing-store",storage.revision).ok, "growing crop blocks storage")
	storage.advance(60000)
	check(not storage.command("store_building","farm-1","ready-store",storage.revision).ok, "unharvested crop blocks storage")
	storage.command("harvest","","storage-harvest",storage.revision)
	var storage_gold: int = storage.gold
	var storage_xp: int = storage.xp
	check(storage.command("store_building","farm-1","store-farm",storage.revision).ok and storage.farm_ids().is_empty() and storage.can_place(5,3,2), "empty farm stored and footprint released")
	check(storage.command("store_building","farm-1","store-farm",0).ok and storage.stored_buildings.size() == 1 and storage.gold == storage_gold, "store retry no duplicate or refund")
	check(storage.count_type("farm") == 1 and not storage.command("plant","farm-1:sprout","stored-plant",storage.revision).ok, "stored farm counts as owned but cannot operate")
	check(not storage.command("restore_building","farm-1,0,0","overlap-restore",storage.revision).ok and storage.stored_buildings.size() == 1, "restore rejects overlap without losing stored building")
	check(storage.command("restore_building","farm-1,5,3","restore-farm",storage.revision).ok and storage.farm_ids() == ["farm-1"] and storage.gold == storage_gold and storage.xp == storage_xp, "free restore preserves stable ID, Gold and XP")
	check(storage.command("restore_building","farm-1,5,3","restore-farm",0).ok and storage.stored_buildings.is_empty() and storage.farm_ids().size() == 1, "restore retry no duplicate")
	check(storage.command("store_building","hatchery-1","store-hatchery",storage.revision).ok and not storage.command("buy_founder","sunbeam","no-hatchery",storage.revision).ok, "stored hatchery cannot accept egg")
	check(storage.command("restore_building","hatchery-1,3,3","restore-hatchery",storage.revision).ok and storage.command("buy_founder","sunbeam","buy-after-restore",storage.revision).ok, "restored hatchery usable")
	check(not storage.command("store_building","hatchery-1","incubating-store",storage.revision).ok, "incubating founder blocks storage")
	storage.advance(30000)
	check(not storage.command("store_building","hatchery-1","ready-egg-store",storage.revision).ok, "ready egg blocks storage")
	check(storage.command("build","light,3,0","storage-light",storage.revision).ok and not storage.command("store_building","building-1","pending-store",storage.revision).ok, "pending building cannot store")
	storage.advance(30000)
	storage.command("place_founder","building-1","storage-place",storage.revision)
	storage.advance(45000)
	storage.command("sell_ray","ray-2","storage-sell",storage.revision)
	check(not storage.command("store_building","building-1","gold-store",storage.revision).ok, "empty habitat with ready Gold cannot store")
	storage.command("collect","building-1","collect-before-store",storage.revision)
	var preserved_ticks: int = storage.habitat_bins["building-1"]["ticks"]
	check(storage.command("store_building","building-1","store-light",storage.revision).ok and not storage.habitat_ids().has("building-1"), "empty collected habitat stored")
	storage.advance(60000)
	check(storage.habitat_bins["building-1"]["ticks"] == preserved_ticks and not storage.command("collect","building-1","stored-collect",storage.revision).ok, "stored habitat preserves fraction without production or collection")
	check(storage.snapshot()["stored_buildings"].size() == 1 and storage.command("restore_building","building-1,3,0","restore-light",storage.revision).ok and storage.habitat_bins["building-1"]["ticks"] == preserved_ticks, "snapshot includes storage and restore retains bin")
	# Bulk feed is a single revision/receipt and only completes the current level.
	var bulk = Model.new()
	check(bulk.feed_level_cost("ray-1") == 20, "fresh level quote is four pips")
	bulk.command("feed", "ray-1", "one-pip", bulk.revision)
	check(bulk.feed_level_cost("ray-1") == 15 and bulk.pips == 1, "partial pip lowers level quote")
	var rev: int = bulk.revision
	var balance: int = bulk.food
	check(not bulk.command("feed_level", "ray-1", "stale-bulk", rev-1).ok and bulk.food == balance and bulk.pips == 1, "stale level action rejected")
	check(bulk.command("feed_level", "ray-1", "bulk", rev).ok and bulk.food == balance-15 and bulk.level == 2 and bulk.pips == 0 and bulk.revision == rev+1, "remaining pips settle atomically")
	check(bulk.command("feed_level", "ray-1", "bulk", rev).ok and bulk.level == 2 and bulk.food == balance-15, "bulk receipt retry cannot debit twice")
	check(not bulk.command("feed", "ray-1", "bulk", bulk.revision).ok, "bulk operation ID cannot change payload")
	bulk.food = 31
	var before: Dictionary = bulk.snapshot()
	check(bulk.feed_level_cost("ray-1") == 32 and not bulk.command("feed_level", "ray-1", "unaffordable-bulk", bulk.revision).ok and bulk.snapshot() == before, "insufficient Food leaves all state unchanged")
	check(bulk.feed_level_cost("missing") == 0 and not bulk.command("feed_level", "missing", "missing-bulk", bulk.revision).ok, "unknown ray rejected")
	var final_level = Model.new()
	final_level.individuals["ray-1"]["level"] = 9
	final_level.individuals["ray-1"]["pips"] = 3
	final_level.food = 129
	check(final_level.feed_level_cost("ray-1") == 129 and final_level.command("feed_level", "ray-1", "last-level", final_level.revision).ok and final_level.level == 10 and final_level.food == 0, "last legal level costs exact remaining pip")
	check(final_level.feed_level_cost("ray-1") == 0 and not final_level.command("feed_level", "ray-1", "past-cap", final_level.revision).ok and final_level.level == 10, "bulk feeding cannot exceed level cap")
	_test_checkpoint_restore()
	print("CITY_MODEL_CHECKS: %d / %d passed" % [checks-failures,checks])
	quit(0 if failures == 0 else 1)

# Domain restore, not browser or disk persistence. Exercise only the actual
# JSON codec and existing commands, including detached state on rejection.
func _test_checkpoint_restore() -> void:
	var source = Model.new()
	var restored = Model.new()
	var opening: Dictionary = source.snapshot()
	check(Model.validate_snapshot(opening), "opening checkpoint validates")
	check(restored.restore_snapshot(JSON.parse_string(JSON.stringify(opening))) and restored.snapshot() == opening, "opening JSON round-trip")
	source.advance(1234)
	check(source.command("sample", "", "restore-sample", source.revision).ok, "restore fixture sample")
	check(source.command("build", "light,3,0", "restore-light", source.revision).ok, "restore fixture Light build")
	check(source.command("buy_founder", "sunbeam", "restore-egg", source.revision).ok, "restore fixture founder purchase")
	check(source.command("plant", "ribbon", "restore-plant", source.revision).ok, "restore fixture crop")
	check(source.command("feed", "ray-1", "restore-feed", source.revision).ok, "restore fixture partial feed")
	var pending_build: Dictionary = source.snapshot()
	check(restored.restore_snapshot(JSON.parse_string(JSON.stringify(pending_build))) and restored.snapshot() == pending_build, "pending build, egg, crop and fractional income round-trip")
	source.advance(30000)
	check(source.command("place_founder", "building-1", "restore-hatch", source.revision).ok, "restore fixture founder placed")
	check(source.command("set_favorite", "ray-2,1", "restore-favorite", source.revision).ok, "restore fixture favorite")
	check(source.command("buy_sector", "2,0", "restore-land", source.revision).ok, "restore fixture expansion")
	check(source.command("clear_obstacle", "starter-obstacle", "restore-clear", source.revision).ok, "restore fixture clearance")
	var checkpoint: Dictionary = source.snapshot()
	var json_value: Variant = JSON.parse_string(JSON.stringify(checkpoint))
	check(Model.validate_snapshot(json_value), "expanded JSON checkpoint validates")
	check(restored.restore_snapshot(json_value) and restored.snapshot() == checkpoint, "restored city equals committed source")
	json_value.individuals["ray-2"].nickname = "External mutation"
	check(restored.snapshot() == checkpoint, "restore detaches input dictionaries")
	check(restored.command("plant", "ribbon", "restore-plant", 0).ok and restored.snapshot() == checkpoint, "restored receipt retries without another debit")
	check(not restored.command("feed", "ray-2", "restore-plant", restored.revision).ok and restored.snapshot() == checkpoint, "restored conflicting receipt rejected")
	check(not restored.command("feed", "ray-2", "stale-after-restore", 0).ok and restored.snapshot() == checkpoint, "restored revision rejects stale action")
	source.advance(300000)
	restored.advance(300000)
	check(restored.snapshot() == source.snapshot() and restored.starter_obstacle.cleared, "resumed deadlines, XP and production match uninterrupted model")
	check(restored.command("harvest", "", "restore-harvest", restored.revision).ok and source.command("harvest", "", "restore-harvest", source.revision).ok and restored.snapshot() == source.snapshot(), "resumed harvest settles identically")
	var cases: Array = []
	var bad: Dictionary = checkpoint.duplicate(true)
	bad.gold = -1
	cases.append(["negative balance", bad])
	bad = checkpoint.duplicate(true)
	bad.food = 0.5
	cases.append(["fractional wallet", bad])
	bad = checkpoint.duplicate(true)
	bad.revision = "9"
	cases.append(["string revision", bad])
	bad = checkpoint.duplicate(true)
	bad.checkpoint_schema = 99
	cases.append(["unsupported schema", bad])
	bad = checkpoint.duplicate(true)
	bad["unknown_future_field"] = true
	cases.append(["unknown schema field", bad])
	bad = checkpoint.duplicate(true)
	bad.individuals["ray-2"].species = "unknown"
	cases.append(["unknown species", bad])
	bad = checkpoint.duplicate(true)
	bad.individuals["ray-2"].habitat_id = "tide-1"
	cases.append(["incompatible habitat", bad])
	bad = checkpoint.duplicate(true)
	bad.habitat_bins.erase("building-1")
	cases.append(["missing habitat bin", bad])
	bad = checkpoint.duplicate(true)
	bad.habitat_bins["building-1"].ticks = 120001
	cases.append(["overflowing habitat bin", bad])
	bad = checkpoint.duplicate(true)
	bad.buildings[1].x = 0
	bad.buildings[1].y = 0
	cases.append(["overlapping footprint", bad])
	bad = checkpoint.duplicate(true)
	bad.stored_buildings.append(bad.buildings[0].duplicate(true))
	cases.append(["duplicate building identity", bad])
	bad = checkpoint.duplicate(true)
	bad.next_ray_serial = 2
	cases.append(["reused ray serial", bad])
	bad = checkpoint.duplicate(true)
	bad.receipts.erase("restore-egg")
	cases.append(["missing acquisition receipt", bad])
	bad = checkpoint.duplicate(true)
	bad.receipts["restore-plant"].argument = "sprout"
	cases.append(["conflicting crop receipt", bad])
	bad = checkpoint.duplicate(true)
	bad.construction.deadline_ms = bad.elapsed_ms
	cases.append(["unsettled past builder deadline", bad])
	bad = checkpoint.duplicate(true)
	bad.individual.pips = 3
	cases.append(["conflicting legacy alias", bad])
	bad = checkpoint.duplicate(true)
	bad.owned_sectors[4] = "3,3"
	cases.append(["nonadjacent expansion", bad])
	var before: Dictionary = restored.snapshot()
	for case in cases:
		check(not Model.validate_snapshot(case[1]) and not restored.restore_snapshot(case[1]) and restored.snapshot() == before, "invalid checkpoint rejected atomically: " + case[0])
	check(restored.command("store_building", "farm-1", "restore-store", restored.revision).ok, "restore fixture stored farm")
	var stored: Dictionary = restored.snapshot()
	check(source.restore_snapshot(JSON.parse_string(JSON.stringify(stored))) and source.snapshot() == stored, "stored building round-trip")
	check(source.command("restore_building", "farm-1,5,3", "restore-return", source.revision).ok, "restored storage permits legal move")
	check(source.command("sell_ray", "ray-1", "restore-sell-starter", source.revision).ok, "restore fixture starter sold")
	var sold: Dictionary = source.snapshot()
	check(restored.restore_snapshot(JSON.parse_string(JSON.stringify(sold))) and restored.snapshot() == sold and restored.individuals.has("ray-2"), "sold starter remains absent after restore")
	_test_ui_receipt_restore()

func _test_ui_receipt_restore() -> void:
	var source = Model.new()
	var restored = Model.new()
	check(source.command("name", "Blueberry", "ui-1000", source.revision).ok, "UI receipt fixture")
	var good: Dictionary = source.snapshot()
	check(restored.restore_snapshot(JSON.parse_string(JSON.stringify(good))) and restored.snapshot() == good, "canonical sparse UI receipt restores")
	for invalid_id in ["ui-", "ui-0", "ui--1", "ui-01", "ui-+1", "ui-1.0", "ui-9007199254740992", "ui-9223372036854775807", "ui-999999999999999999999999999"]:
		var bad: Dictionary = good.duplicate(true)
		bad.receipts[invalid_id] = bad.receipts["ui-1000"]
		bad.receipts.erase("ui-1000")
		check(not Model.validate_snapshot(JSON.parse_string(JSON.stringify(bad))) and not restored.restore_snapshot(bad) and restored.snapshot() == good, "malformed UI receipt restore is atomic: " + invalid_id)
		check(not restored.command("feed", "ray-1", invalid_id, restored.revision).ok and restored.snapshot() == good, "malformed UI command is atomic: " + invalid_id)
	var view = load("res://city_view.gd").new()
	check(view.city.restore_snapshot(good), "view restores canonical UI receipt")
	var fresh: String = view.next_ui_operation_id()
	check(fresh == "ui-1001" and view.city.command("feed", "ray-1", fresh, view.city.revision).ok, "restored high-water allocates fresh feed")
	check(view.next_ui_operation_id() == "ui-1002", "restored high-water advances")
	view.free()
	var boundary = Model.new()
	check(boundary.command("name", "Blueberry", "ui-1", boundary.revision).ok, "UI wrap fixture occupies first ID")
	check(boundary.command("name", "Blueberry", "ui-9007199254740991", boundary.revision).ok, "UI wrap fixture occupies ceiling")
	var wrap_view = load("res://city_view.gd").new()
	check(wrap_view.city.restore_snapshot(JSON.parse_string(JSON.stringify(boundary.snapshot()))), "valid ceiling UI receipt restores")
	var wrapped: String = wrap_view.next_ui_operation_id()
	check(wrapped == "ui-2" and wrap_view.city.command("feed", "ray-1", wrapped, wrap_view.city.revision).ok, "ceiling skips occupied UI ID without overflow")
	var next: String = wrap_view.next_ui_operation_id()
	check(next == "ui-3" and wrap_view.city.command("feed", "ray-1", next, wrap_view.city.revision).ok, "wrapped UI allocation continues with distinct action")
	check(Model.validate_snapshot(wrap_view.city.snapshot()), "wrapped receipt ledger remains restorable")
	wrap_view.free()
